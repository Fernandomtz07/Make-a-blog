---
const pageTitle = "Sobre mi";

const identity = {
  firstName: "Fernando",
  country: "México",
  occupation: "Estudiante Dessarrollador de software",
  hobbies: ["Fútbol", "Videojuegos", "Música", "Cine"],
};

const skills = [
  "HTML",
  "CSS",
  "JavaScript",
  "React",
  "Astro",
  "Redacción de documentos",
];
const happy = true;
const finished = false;
const goal = 3;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <style>
      h1 {
        color: red;
        font-size: 4rem;
      }
      .skill {
        color: blue;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <a href="/">Inicio</a><br />
    <a href="/about/">Sobre mi</a><br />
    <a href="/blog/">Blog</a><br />
    <h1>{pageTitle}</h1>

    <p>He aquí algunos datos sobre mí:</p>
    <ul>
      <li>Me llamo {identity.firstName}.</li>
      <li>Vivo en {identity.country} y trabajo como {identity.occupation}.</li>
      {
        identity.hobbies.length >= 2 && (
          <li>
            Dos de mis aficiones son: {identity.hobbies[0]} y{" "}
            {identity.hobbies[1]}
          </li>
        )
      }
    </ul>
    <p>Mis habilidades son:</p>
    <ul>
      {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>
  </body>
  {happy && <p>¡Estoy feliz de aprender Astro!</p>}

  {finished && <p>¡He terminado este tutorial!</p>}

  {
    goal === 3 ? (
      <p>Mi objetivo es terminar en 3 días.</p>
    ) : (
      <p>Mi objetivo no son 3 días.</p>
    )
  }
</html>
