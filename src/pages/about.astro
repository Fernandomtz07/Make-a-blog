---
import Header from "../components/Header.astro";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
const pageTitle = "Sobre mi";

const identity = {
  firstName: "Fernando",
  country: "México",
  occupation: "Estudiante Dessarrollador de software",
  hobbies: ["Fútbol", "Videojuegos", "Música", "Cine"],
};

const skills = [
  "HTML",
  "CSS",
  "JavaScript",
  "React",
  "Astro",
  "Redacción de documentos",
];
const happy = true;
const finished = false;
const goal = 3;
const skillColor = "crimson";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <style>
      h1 {
        color: var(--skillColor);
        font-size: 4rem;
      }
      .skill {
        color: blue;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <Navigation />
    <h1>{pageTitle}</h1>

    <p>Un poco sobre mí:</p>
    <ul>
      <li>Me llamo {identity.firstName}.</li>
      <li>Vivo en {identity.country} y trabajo como {identity.occupation}.</li>
      {
        identity.hobbies.length >= 2 && (
          <li>
            Mis aficiones son: {identity.hobbies[0]} y {identity.hobbies[1]}
          </li>
        )
      }
    </ul>
    <p>Mis habilidades son:</p>
    <ul>
      {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>
    <Footer />
    <script>
      import "../scripts/menu.js";
    </script>
  </body>
  {happy && <p>Estoy feliz con el curso de web 2</p>}

  {finished && <p>Ya he terminado el curso</p>}

  {
    goal === 3 ? (
      <p>Quiero terminar este curso en los siguientes 3 días de ser posible.</p>
    ) : (
      <p>Mi objetivo no son 3 días.</p>
    )
  }
</html>
